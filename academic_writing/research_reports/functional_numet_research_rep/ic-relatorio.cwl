%-----------------------------------------------------------------------------%
% Esse arquivo define o autocompletamento dos comandos da classe profmat-cefet
%
% Para utilizá-lo copie-o para a pasta
%   C:\Usuários\[Nome_do_usuario]\AppData\Roaming\texstudio\completion\user
% ou se o computador estiver em inglês
%   C:\Users\[Nome_do_usuario]\AppData\Roaming\texstudio\completion\user
% onde [Nome_do_usuario] é o nome do seu usuário no Windows. Note também
% que a pasta AppData fica oculta no Windows.
%
% No linux copie esse arquivo para a pasta
%   ~/.config/texstudio/completion/user/
%
%-----------------------------------------------------------------------------%

#include:book
#include:biblatex
#include:amsfonts
#include:amsmath
#include:amssymb
#include:amsthm
#include:array
#include:babel
#include:caption
#include:changepage
#include:comment
#include:csquotes
#include:fancyhdr
#include:fontenc
#include:geometry
#include:graphicx
#include:hyperref
#include:icomma
#include:latexsym
#include:nccmath
#include:pdfpages
#include:placeins
#include:setspace
#include:textcase
#include:textpos
#include:tikz
#include:titlesec
#include:tocbibind
#include:etoolbox
#include:xparse
#include:xfrac
#include:inputenc
#include:indentfirst
#include:ae
#include:enumitem

\begin{teorema}[Name%text]%N
\begin{axioma}[Name%text]%N
\begin{definicao}[Name%text]%N
\begin{postulado}[Name%text]%N
\begin{proposicao}[Name%text]%N
\begin{lema}[Name%text]%N
\begin{corolario}[Name%text]%N
\begin{exemplo}
\begin{exercicio}
\end{teorema}
\end{axioma}
\end{definicao}
\end{postulado}
\end{proposicao}
\end{lema}
\end{corolario}
\end{exemplo}
\end{exercicio}

\annex

\arcsec{arg}#m
\arccsc{arg}#m
\arccot{arg}#m
\N#m
\Z#m
\Q#m
\R#m
\C#m

\autor{Name%text}
\autora{Name%text}
\orientador{Name%text}
\orientadora{Name%text}
\coorientador{Name%text}
\coorientadora{Name%text}
\coorientadores{Names%text}
\coorientadoras{Names%text}

\date{DD}{MM}{AA}
\banca{text}

\begin{dedication}
\begin{Resumo}
\begin{Abstract}
\begin{acknowledgement}
\end{dedication}
\end{Resumo}
\end{Abstract}
\end{acknowledgement}

\PalavrasChave
\Keywords

\fonte{text}
\fonteCite}{text}{label}
\fonteUrl{url}
\fonteAutor

